# The `@deepseek-ai/dsh-*` packages are pinned to the exact host version and listed as peer
# dependencies: at runtime the installing profile provides them, and for local type-checking and
# tests they are installed as dev dependencies — together with the transitive peers of
# `dsh-tools`/`dsh-agent`/`dsh-llm`, which `legacy-peer-deps` below stops npm from installing
# on its own. Their own peers are likewise the host's, so npm must not try to resolve the
# graph by installing a second copy of the host — which is also what keeps `npm install` here
# small and quick.
legacy-peer-deps=true
